# Copiar para experiments/smoke_e2e_sentimentos/modulo2_poc/.env
# NUNCA commitar o arquivo .env preenchido.

# URL pública HTTPS do Dashboard (mesmo host do Named Tunnel → :8000).
# Exemplo: https://presenca.seudominio.com
# Sem barra final. Nunca localhost / :8766 em produção.
M2_PUBLIC_BASE_URL=

# Segredo HMAC de sessões/claim (gere um valor longo e aleatório).
# Ex.: openssl rand -hex 32
M2_ENROLL_HMAC_SECRET=

# Dual-write operacional → Supabase A (presença). Sem biometria.
# Fallback: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY do Edge.
M2_OPS_SUPABASE_URL=
M2_OPS_SUPABASE_SERVICE_KEY=

# auto | supabase | fixtures — produção: auto ou supabase
M2_ROSTER_SOURCE=auto

# Nunca ligar hooks de teste em produção.
M2_POC_TEST_HOOKS=0
